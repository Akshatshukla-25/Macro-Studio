[
  {
    "id": "template-coding",
    "name": "Start Coding",
    "description": "Opens VS Code, launches dev server, waits until localhost:3000 is ready, opens browser, and speaks announcement.",
    "category": "Development",
    "actions": [
      {
        "id": "act-1",
        "type": "openApp",
        "label": "Open Visual Studio Code",
        "value": "Visual Studio Code"
      },
      {
        "id": "act-2",
        "type": "command",
        "label": "Start Dev Server",
        "value": "npm run dev"
      },
      {
        "id": "act-3",
        "type": "waitForUrl",
        "label": "Wait Until Localhost Responds",
        "value": "http://localhost:3000",
        "timeout": 15000
      },
      {
        "id": "act-4",
        "type": "openUrl",
        "label": "Open Localhost in Browser",
        "value": "http://localhost:3000"
      },
      {
        "id": "act-5",
        "type": "snapWindow",
        "label": "Maximize Browser Window",
        "value": "Google Chrome",
        "position": "maximize"
      },
      {
        "id": "act-6",
        "type": "speak",
        "label": "Voice Announcement",
        "value": "Development server is live on port 3000. Happy coding!"
      }
    ]
  },
  {
    "id": "template-study",
    "name": "Study & Research Session",
    "description": "Prepares research workspace with browser tabs, notes app, window layout, and voice alert.",
    "category": "Education",
    "actions": [
      {
        "id": "act-1",
        "type": "openUrl",
        "label": "Open Research Portal",
        "value": "https://scholar.google.com"
      },
      {
        "id": "act-2",
        "type": "snapWindow",
        "label": "Snap Browser to Left Half",
        "value": "Google Chrome",
        "position": "left"
      },
      {
        "id": "act-3",
        "type": "openApp",
        "label": "Open Notes / Reader",
        "value": "Notes"
      },
      {
        "id": "act-4",
        "type": "snapWindow",
        "label": "Snap Notes to Right Half",
        "value": "Notes",
        "position": "right"
      },
      {
        "id": "act-5",
        "type": "speak",
        "label": "Voice Encouragement",
        "value": "Focus session initialized. Enjoy your study time!"
      }
    ]
  },
  {
    "id": "template-gaming",
